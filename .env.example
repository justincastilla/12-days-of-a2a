# Elastic Agent Builder Configuration
# Copy this file to .env and fill in your values

# Elasticsearch Endpoint
# The full URL to your Elasticsearch instance
# Example: https://example-project-a123.es.westus2.azure.elastic.cloud:443
ES_ENDPOINT=<YOUR-ELASTICSEARCH-ENDPOINT>

# Elastic Agent Builder A2A URL
# To get this:
# 1. In Elastic Agent Builder, go to Tools page
# 2. Click "MCP Server" dropdown, select "Copy MCP Server URL"
# 3. Replace "mcp" at the end of the URL with "a2a"
# Example: https://example-project-a123.kb.westus2.azure.elastic.cloud/api/agent_builder/a2a
ES_AGENT_URL=<YOUR-ELASTIC-AGENT-BUILDER-URL>

# Elastic API Key
# To get this:
# 1. In Elastic project, click "Elasticsearch" in navigation
# 2. Click "Create API key" to create a new key
# 3. Copy the API Key value
ES_API_KEY=<YOUR-ELASTIC-API-KEY>

# Elastic Agent ID for searching gift documents
# The ID of the agent you created in Elastic Agent Builder
# Example: christmas_gifts_agent
ES_AGENT_ID=christmas_gifts_agent

# Index name for Christmas gifts documents
# The Elasticsearch index where gift documents are stored
ES_INDEX_NAME=christmas-gifts
